<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FuckThisLoadingScreen</AssemblyName>
    <RootNamespace>FuckThisLoadingScreen</RootNamespace>
    <SptProjectKind>Client</SptProjectKind>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- AssetsTools.NET must sit next to the plugin dll; it is shipped by scripts/Build.ps1. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.0" />
    <Reference Include="BepInEx"><HintPath>$(SptInstallPath)/BepInEx/core/BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptInstallPath)/BepInEx/core/0Harmony.dll</HintPath></Reference>
    <Reference Include="Comfort.Unity"><HintPath>$(SptInstallPath)/EscapeFromTarkov_Data/Managed/Comfort.Unity.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SptInstallPath)/EscapeFromTarkov_Data/Managed/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SptInstallPath)/EscapeFromTarkov_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(SptInstallPath)/EscapeFromTarkov_Data/Managed/UnityEngine.AssetBundleModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.StreamingModule"><HintPath>$(SptInstallPath)/EscapeFromTarkov_Data/Managed/UnityEngine.StreamingModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
